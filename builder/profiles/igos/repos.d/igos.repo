# IGOS Nusantara 26 (AlmaLinux 10 based), all from R2. Repos left disabled
# can be enabled.
[igos-baseos]
name=IGOS Nusantara 26 - BaseOS
baseurl=https://r2.igos-nusantara.or.id/26/BaseOS/
enabled=1
gpgcheck=1
gpgkey=https://repo.almalinux.org/almalinux/RPM-GPG-KEY-AlmaLinux-10

[igos-appstream]
name=IGOS Nusantara 26 - AppStream
baseurl=https://r2.igos-nusantara.or.id/26/AppStream/
enabled=1
gpgcheck=1
gpgkey=https://repo.almalinux.org/almalinux/RPM-GPG-KEY-AlmaLinux-10

[igos-crb]
name=IGOS Nusantara 26 - CRB
baseurl=https://r2.igos-nusantara.or.id/26/CRB/
enabled=1
gpgcheck=1
gpgkey=https://repo.almalinux.org/almalinux/RPM-GPG-KEY-AlmaLinux-10

[igos-extras]
name=IGOS Nusantara 26 - Extras
baseurl=https://r2.igos-nusantara.or.id/26/extras/
enabled=1
gpgcheck=1
gpgkey=https://repo.almalinux.org/almalinux/RPM-GPG-KEY-AlmaLinux-10

# IGOS's own packages. Its metadata is incomplete at the moment, so a
# failure to load it does not stop a build.
[igos-ign]
name=IGOS Nusantara 26 - IGN
baseurl=https://r2.igos-nusantara.or.id/26/ign/
enabled=1
gpgcheck=0
skip_if_unavailable=1

[igos-epel]
name=IGOS Nusantara 26 - EPEL
baseurl=https://r2.igos-nusantara.or.id/26/epel/
enabled=1
gpgcheck=1
gpgkey=https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-10

# Broadcom wl (MacBook Wi-Fi) and other free/nonfree extras.
[igos-rpmfusion]
name=IGOS Nusantara 26 - RPM Fusion
baseurl=https://r2.igos-nusantara.or.id/26/rpmfusion/
enabled=1
gpgcheck=1
gpgkey=https://download1.rpmfusion.org/free/el/RPM-GPG-KEY-rpmfusion-free-el-10
       https://download1.rpmfusion.org/nonfree/el/RPM-GPG-KEY-rpmfusion-nonfree-el-10

[igos-elrepo]
name=IGOS Nusantara 26 - ELRepo
baseurl=https://r2.igos-nusantara.or.id/26/elrepo/
enabled=0
gpgcheck=1
gpgkey=https://www.elrepo.org/RPM-GPG-KEY-v2-elrepo.org

[igos-nvidia]
name=IGOS Nusantara 26 - NVIDIA
baseurl=https://r2.igos-nusantara.or.id/26/nvidia/
enabled=0
gpgcheck=0

[igos-plus]
name=IGOS Nusantara 26 - Plus
baseurl=https://r2.igos-nusantara.or.id/26/plus/
enabled=0
gpgcheck=1
gpgkey=https://repo.almalinux.org/almalinux/RPM-GPG-KEY-AlmaLinux-10

[igos-remi]
name=IGOS Nusantara 26 - Remi
baseurl=https://r2.igos-nusantara.or.id/26/remi/
enabled=0
gpgcheck=0
