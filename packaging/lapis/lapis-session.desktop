[Desktop Entry]
Type=Application
Name=Lapis Android session
Comment=Starts the lapis Android container for this desktop session, once lapis is enabled
Exec=sh -c "systemctl is-enabled -q lapis-control.socket && systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE && systemctl --user start lapis-session.service"
NoDisplay=true
