# Build environment for Bayu: AlmaLinux 10 with the spec's BuildRequires and
# the tools builder/ uses.
ARG BASE=docker.io/almalinux/10-base:latest
FROM ${BASE}
# Empty: use the mirrorlists. Otherwise base URLs of an AlmaLinux / EPEL mirror.
ARG ALMA_MIRROR=
ARG EPEL_MIRROR=
COPY bayu-desktop.spec /tmp/
RUN if [ -n "$ALMA_MIRROR" ]; then sed -i -e 's/^mirrorlist=/#mirrorlist=/' \
      -e "s|^# *baseurl=https://repo.almalinux.org/almalinux|baseurl=$ALMA_MIRROR|" /etc/yum.repos.d/almalinux*.repo; fi && \
    dnf -y install epel-release dnf-plugins-core && dnf config-manager --set-enabled crb && \
    if [ -n "$EPEL_MIRROR" ]; then sed -i -e 's/^metalink=/#metalink=/' \
      -e "s|^# *baseurl=https://download.example/pub/epel|baseurl=$EPEL_MIRROR|" /etc/yum.repos.d/epel*.repo; fi && \
    dnf -y install rpm-build createrepo_c qemu-img gdisk xfsprogs && \
    dnf -y builddep /tmp/bayu-desktop.spec && \
    dnf clean all
