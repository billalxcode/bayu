msgid "Cannot export the Bluetooth pairing agent."
msgstr "Teu tiasa ngékspor agén pasangan Bluetooth."

#: clients/bluez/manager.cpp
msgid "Enter a PIN containing 1–16 bytes."
msgstr "Lebetkeun PIN anu eusina 1–16 bait."

#: clients/bluez/manager.cpp
msgid "Enter a passkey containing 1–6 digits."
msgstr "Lebetkeun passkey anu eusina 1–6 angka."

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't connect to {device}"
msgstr "Teu tiasa nyambung ka {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't connect to the device"
msgstr "Teu tiasa nyambung ka parangkat"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't disconnect {device}"
msgstr "Teu tiasa megatkeun sambungan {device}"

