msgid "Couldn't disconnect the device"
msgstr "Teu tiasa megatkeun sambungan parangkat"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't pair with {device}"
msgstr "Teu tiasa pasangan jeung {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't pair with the device"
msgstr "Teu tiasa pasangan jeung parangkat"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't forget {device}"
msgstr "Teu tiasa ngalalaworakeun {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't forget the device"
msgstr "Teu tiasa ngalalaworakeun parangkat"

#: clients/bluez/manager.cpp
msgid "Try again. If it keeps failing, turn the device off and on again."
msgstr "Cobian deui. Mun tetep gagal, pareuman tuluy hurungkeun deui parangkatna."

#: clients/bluez/manager.cpp
msgid "The device didn't respond in time. Make sure it is turned on and nearby."
msgstr "Parangkat teu ngawaler dina waktosna. Pastikeun parangkat hurung sarta caket."

#: clients/bluez/manager.cpp
msgid "The device didn't respond. Make sure it is turned on, nearby, and not connected to another device."
msgstr "Parangkat teu ngawaler. Pastikeun parangkat hurung, caket, sarta teu nyambung ka parangkat séjén."

#: clients/bluez/manager.cpp
msgid "The device no longer recognizes this computer. Forget the device and pair it again."
msgstr "Parangkat geus teu ngenalan komputer ieu. Lalawora parangkatna tuluy pasangkeun deui."

#: clients/bluez/manager.cpp
msgid "Pairing failed. Make sure the code matches on both devices and try again."
msgstr "Pasangan gagal. Pastikeun kodena sarua dina duanana parangkat tuluy cobian deui."

#: clients/bluez/manager.cpp
msgid "The device declined the request."
msgstr "Parangkat nolak pamundut."

#: clients/bluez/manager.cpp
msgid "The device refused the connection."
msgstr "Parangkat nolak sambungan."

#: clients/bluez/manager.cpp
msgid "The device has no features this computer can use."
msgstr "Parangkat teu gaduh fitur anu tiasa dipaké ku komputer ieu."

#: clients/bluez/manager.cpp
msgid "Bluetooth is turned off."
msgstr "Bluetooth pareum."

#: clients/bluez/manager.cpp
msgid "Too many devices are connected. Disconnect one and try again."
msgstr "Kabéh parangkat nyambung. Pegatkeun hiji tuluy cobian deui."

#: clients/bluez/manager.cpp
msgid "The device ended the connection."
msgstr "Parangkat ngeureunkeun sambungan."

#: clients/bluez/manager.cpp
msgid "The connection was interrupted. Try again."
msgstr "Sambungan kaganggu. Cobian deui."

