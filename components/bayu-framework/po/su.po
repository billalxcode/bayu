msgid "This device is no longer available."
msgstr "Parangkat ieu parantos teu sayogi."

#: clients/bluez/manager.cpp
msgid "The device is busy. Try again in a moment."
msgstr "Parangkat nuju sibuk. Cobian deui sakedap deui."

