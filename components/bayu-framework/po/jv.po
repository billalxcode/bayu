msgid "The device declined the request."
msgstr "Piranti nolak panjaluk."

#: clients/bluez/manager.cpp
msgid "The device refused the connection."
msgstr "Piranti nolak sambungan."

#: clients/bluez/manager.cpp
msgid "The device has no features this computer can use."
msgstr "Piranti ora duwe fitur sing bisa digunakake komputer iki."

#: clients/bluez/manager.cpp
msgid "Bluetooth is turned off."
msgstr "Bluetooth mati."

