#: clients/networkmanager/handler.cpp
msgid "The hotspot could not be started. The Wi-Fi adapter may not support it on this channel or with this password."
msgstr "Hotspot ora bisa diwiwiti. Adaptor Wi-Fi mbokmenawa ora ndhukung ing saluran iki utawa nganggo tembung sandhi iki."

#: clients/networkmanager/handler.cpp
msgid "No Wi-Fi adapter can run a hotspot."
msgstr "Ora ana adaptor Wi-Fi sing bisa mlakokake hotspot."

#: clients/networkmanager/handler.cpp
msgid "No VPN plugin can read this file. Install the one for your VPN, for example network-manager-openvpn for OpenVPN."
msgstr "Ora ana plugin VPN sing bisa maca berkas iki. Pasang sing kanggo VPN sampeyan, contone network-manager-openvpn kanggo OpenVPN."

#: clients/networkmanager/handler.cpp
msgid "This file isn't a VPN configuration this system can read."
msgstr "Berkas iki dudu konfigurasi VPN sing bisa diwaca sistem iki."

#: clients/networkmanager/handler.cpp
msgid "nmcli, which reads VPN files, is not installed."
msgstr "nmcli, sing maca berkas VPN, durung dipasang."

#: clients/networkmanager/handler.cpp
msgid "The private key can't be read, so the file would be incomplete."
msgstr "Kunci pribadi ora bisa diwaca, dadi berkas bakal ora lengkap."

#: clients/networkmanager/handler.cpp
msgid "The file can't be written."
msgstr "Berkas ora bisa ditulis."

#: clients/networkmanager/handler.cpp
msgid "nmcli, which writes VPN files, is not installed."
msgstr "nmcli, sing nulis berkas VPN, durung dipasang."

#: clients/networkmanager/handler.cpp
msgid "The VPN couldn't be written to a file."
msgstr "VPN ora bisa ditulis menyang berkas."

