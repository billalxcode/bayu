msgid "Cannot export the Bluetooth pairing agent."
msgstr "Tidak dapat mengekspor agen pemasangan Bluetooth."

#: clients/bluez/manager.cpp
msgid "Enter a PIN containing 1–16 bytes."
msgstr "Masukkan PIN yang berisi 1–16 byte."

#: clients/bluez/manager.cpp
msgid "Enter a passkey containing 1–6 digits."
msgstr "Masukkan kunci sandi yang berisi 1–6 digit."

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't connect to {device}"
msgstr "Tidak dapat terhubung ke {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't connect to the device"
msgstr "Tidak dapat terhubung ke perangkat"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't disconnect {device}"
msgstr "Tidak dapat memutuskan {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't disconnect the device"
msgstr "Tidak dapat memutuskan perangkat"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't pair with {device}"
msgstr "Tidak dapat memasangkan dengan {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't pair with the device"
msgstr "Tidak dapat memasangkan dengan perangkat"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't forget {device}"
msgstr "Tidak dapat melupakan {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't forget the device"
msgstr "Tidak dapat melupakan perangkat"

#: clients/bluez/manager.cpp
msgid "Try again. If it keeps failing, turn the device off and on again."
msgstr "Coba lagi. Jika terus gagal, matikan lalu hidupkan kembali perangkat."

#: clients/bluez/manager.cpp
msgid "The device didn't respond in time. Make sure it is turned on and nearby."
msgstr "Perangkat tidak merespons tepat waktu. Pastikan perangkat menyala dan berada di dekat Anda."

#: clients/bluez/manager.cpp
msgid "The device didn't respond. Make sure it is turned on, nearby, and not connected to another device."
msgstr "Perangkat tidak merespons. Pastikan perangkat menyala, berada di dekat Anda, dan tidak terhubung ke perangkat lain."

#: clients/bluez/manager.cpp
msgid "The device no longer recognizes this computer. Forget the device and pair it again."
msgstr "Perangkat tidak lagi mengenali komputer ini. Lupakan perangkat lalu pasangkan kembali."

#: clients/bluez/manager.cpp
msgid "Pairing failed. Make sure the code matches on both devices and try again."
msgstr "Pemasangan gagal. Pastikan kode cocok di kedua perangkat lalu coba lagi."

#: clients/bluez/manager.cpp
msgid "The device declined the request."
msgstr "Perangkat menolak permintaan."

#: clients/bluez/manager.cpp
msgid "The device refused the connection."
msgstr "Perangkat menolak koneksi."

#: clients/bluez/manager.cpp
msgid "The device has no features this computer can use."
msgstr "Perangkat tidak memiliki fitur yang dapat digunakan komputer ini."

#: clients/bluez/manager.cpp
msgid "Bluetooth is turned off."
msgstr "Bluetooth dimatikan."

#: clients/bluez/manager.cpp
msgid "Too many devices are connected. Disconnect one and try again."
msgstr "Terlalu banyak perangkat yang terhubung. Putuskan salah satu lalu coba lagi."

#: clients/bluez/manager.cpp
msgid "The device ended the connection."
msgstr "Perangkat mengakhiri koneksi."

#: clients/bluez/manager.cpp
msgid "The connection was interrupted. Try again."
msgstr "Koneksi terputus. Coba lagi."

