#: clients/networkmanager/handler.cpp
msgid "The hotspot could not be started. The Wi-Fi adapter may not support it on this channel or with this password."
msgstr "Hotspot tidak dapat dijalankan. Adaptor Wi-Fi mungkin tidak mendukungnya pada kanal ini atau dengan kata sandi ini."

#: clients/networkmanager/handler.cpp
msgid "No Wi-Fi adapter can run a hotspot."
msgstr "Tidak ada adaptor Wi-Fi yang dapat menjalankan hotspot."

#: clients/networkmanager/handler.cpp
msgid "No VPN plugin can read this file. Install the one for your VPN, for example network-manager-openvpn for OpenVPN."
msgstr "Tidak ada plugin VPN yang dapat membaca berkas ini. Pasang plugin untuk VPN Anda, misalnya network-manager-openvpn untuk OpenVPN."

#: clients/networkmanager/handler.cpp
msgid "This file isn't a VPN configuration this system can read."
msgstr "Berkas ini bukan konfigurasi VPN yang dapat dibaca sistem ini."

#: clients/networkmanager/handler.cpp
msgid "nmcli, which reads VPN files, is not installed."
msgstr "nmcli, yang membaca berkas VPN, belum terpasang."

#: clients/networkmanager/handler.cpp
msgid "The private key can't be read, so the file would be incomplete."
msgstr "Kunci privat tidak dapat dibaca, sehingga berkas akan tidak lengkap."

#: clients/networkmanager/handler.cpp
msgid "The file can't be written."
msgstr "Berkas tidak dapat ditulis."

#: clients/networkmanager/handler.cpp
msgid "nmcli, which writes VPN files, is not installed."
msgstr "nmcli, yang menulis berkas VPN, belum terpasang."

#: clients/networkmanager/handler.cpp
msgid "The VPN couldn't be written to a file."
msgstr "VPN tidak dapat ditulis ke berkas."

