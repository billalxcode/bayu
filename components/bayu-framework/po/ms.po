msgid "Couldn't pair with the device"
msgstr "Tidak dapat berpasangan dengan peranti"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't forget {device}"
msgstr "Tidak dapat melupakan {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't forget the device"
msgstr "Tidak dapat melupakan peranti"

#: clients/bluez/manager.cpp
msgid "Try again. If it keeps failing, turn the device off and on again."
msgstr "Cuba lagi. Jika masih gagal, matikan peranti dan hidupkannya semula."

#: clients/bluez/manager.cpp
msgid "The device didn't respond in time. Make sure it is turned on and nearby."
msgstr "Peranti tidak bertindak balas tepat pada masanya. Pastikan ia dihidupkan dan berdekatan."

#: clients/bluez/manager.cpp
msgid "The device didn't respond. Make sure it is turned on, nearby, and not connected to another device."
msgstr "Peranti tidak bertindak balas. Pastikan ia dihidupkan, berdekatan, dan tidak disambungkan kepada peranti lain."

#: clients/bluez/manager.cpp
msgid "The device no longer recognizes this computer. Forget the device and pair it again."
msgstr "Peranti tidak lagi mengenali komputer ini. Lupakan peranti dan pasangkannya semula."

#: clients/bluez/manager.cpp
msgid "Pairing failed. Make sure the code matches on both devices and try again."
msgstr "Pemasangan berpasangan gagal. Pastikan kod sepadan pada kedua-dua peranti dan cuba lagi."

#: clients/bluez/manager.cpp
msgid "The device declined the request."
msgstr "Peranti menolak permintaan."

#: clients/bluez/manager.cpp
msgid "The device refused the connection."
msgstr "Peranti menolak sambungan."

#: clients/bluez/manager.cpp
msgid "The device has no features this computer can use."
msgstr "Peranti tidak mempunyai ciri yang boleh digunakan oleh komputer ini."

#: clients/bluez/manager.cpp
msgid "Bluetooth is turned off."
msgstr "Bluetooth dimatikan."

#: clients/bluez/manager.cpp
msgid "Too many devices are connected. Disconnect one and try again."
msgstr "Terlalu banyak peranti disambungkan. Putuskan sambungan satu dan cuba lagi."

#: clients/bluez/manager.cpp
msgid "The device ended the connection."
msgstr "Peranti menamatkan sambungan."

#: clients/bluez/manager.cpp
msgid "The connection was interrupted. Try again."
msgstr "Sambungan terganggu. Cuba lagi."

