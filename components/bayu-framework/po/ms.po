msgid "Cannot export the Bluetooth pairing agent."
msgstr "Tidak dapat mengeksport ejen pemasangan berpasangan Bluetooth."

#: clients/bluez/manager.cpp
msgid "Enter a PIN containing 1–16 bytes."
msgstr "Masukkan PIN yang mengandungi 1–16 bait."

#: clients/bluez/manager.cpp
msgid "Enter a passkey containing 1–6 digits."
msgstr "Masukkan kunci laluan yang mengandungi 1–6 digit."

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't connect to {device}"
msgstr "Tidak dapat menyambung ke {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't connect to the device"
msgstr "Tidak dapat menyambung ke peranti"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't disconnect {device}"
msgstr "Tidak dapat memutuskan sambungan {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't disconnect the device"
msgstr "Tidak dapat memutuskan sambungan peranti"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't pair with {device}"
msgstr "Tidak dapat berpasangan dengan {device}"

