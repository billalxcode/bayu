msgid "No Wi-Fi adapter can run a hotspot."
msgstr "Tiada penyesuai Wi-Fi yang boleh menjalankan hotspot."

#: clients/networkmanager/handler.cpp
msgid "No VPN plugin can read this file. Install the one for your VPN, for example network-manager-openvpn for OpenVPN."
msgstr "Tiada pemalam VPN yang boleh membaca fail ini. Pasang pemalam untuk VPN anda, contohnya network-manager-openvpn untuk OpenVPN."

#: clients/networkmanager/handler.cpp
msgid "This file isn't a VPN configuration this system can read."
msgstr "Fail ini bukan konfigurasi VPN yang boleh dibaca oleh sistem ini."

#: clients/networkmanager/handler.cpp
msgid "nmcli, which reads VPN files, is not installed."
msgstr "nmcli, yang membaca fail VPN, tidak dipasang."

#: clients/networkmanager/handler.cpp
msgid "The private key can't be read, so the file would be incomplete."
msgstr "Kunci peribadi tidak dapat dibaca, jadi fail akan tidak lengkap."

#: clients/networkmanager/handler.cpp
msgid "The file can't be written."
msgstr "Fail tidak dapat ditulis."

#: clients/networkmanager/handler.cpp
msgid "nmcli, which writes VPN files, is not installed."
msgstr "nmcli, yang menulis fail VPN, tidak dipasang."

#: clients/networkmanager/handler.cpp
msgid "The VPN couldn't be written to a file."
msgstr "VPN tidak dapat ditulis ke fail."

