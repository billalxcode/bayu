<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Bayu</vendor>
  <action id="org.bayu.filemanager.admin">
    <description>Open folders as an administrator</description>
    <description xml:lang="id">Buka folder sebagai administrator</description>
    <message>Authentication is required to open folders as an administrator</message>
    <message xml:lang="id">Autentikasi diperlukan untuk membuka folder sebagai administrator</message>
    <icon_name>system-file-manager</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/bayu-admin-mount</annotate>
  </action>
</policyconfig>
