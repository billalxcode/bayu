<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Bayu</vendor>
  <vendor_url>https://github.com/igos-nusantara/bayu</vendor_url>

  <action id="org.bayu.privacy.switch-devices">
    <description>Turn the camera or microphone on or off</description>
    <message>Authentication is required to turn the camera or microphone on or off</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
