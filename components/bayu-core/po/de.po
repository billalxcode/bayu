#: bayu-services/battery/battery.cpp
msgid "Calculating…"
msgstr "Wird berechnet …"

#: bayu-services/battery/battery.cpp
#, python-brace-format
msgid "{time} until fully charged"
msgstr "{time} bis zur vollständigen Aufladung"

#: bayu-services/battery/battery.cpp
#, python-brace-format
msgid "{time} remaining"
msgstr "{time} verbleibend"

#: bayu-services/battery/battery.cpp
msgid "Fully charged."
msgstr "Vollständig geladen."

#: bayu-services/battery/battery.cpp
#, python-brace-format
msgid "Charging paused at {percent}%"
msgstr "Laden bei {percent} % pausiert"

#: bayu-services/battery/battery.cpp
msgid "Not charging"
msgstr "Wird nicht geladen"

#. TRANSLATORS: days in a short battery time such as "1d 2h 5m".
#: bayu-services/battery/battery.cpp
#, python-brace-format
msgid "{n}d"
msgstr "{n} T"

#. TRANSLATORS: hours in a short battery time such as "2h 5m".
#: bayu-services/battery/battery.cpp
#, python-brace-format
msgid "{n}h"
msgstr "{n} Std."

#. TRANSLATORS: minutes in a short battery time such as "2h 5m".
#: bayu-services/battery/battery.cpp
#, python-brace-format
msgid "{n}m"
msgstr "{n} Min."

#. TRANSLATORS: when the battery was last fully charged, under a minute ago.
#: bayu-services/battery/battery.cpp
msgid "now"
msgstr "jetzt"

#: bayu-services/battery/battery.cpp
#, python-brace-format
msgid "{time} ago"
msgstr "vor {time}"

#: bayu-services/battery/batterywarning.cpp
msgid "Low Battery"
msgstr "Akku schwach"

#: bayu-services/battery/batterywarning.cpp
msgid "Battery Critically Low"
msgstr "Akku kritisch schwach"

#: bayu-services/battery/batterywarning.cpp
msgid "Battery Empty"
msgstr "Akku leer"

#: bayu-services/battery/batterywarning.cpp
#, python-brace-format
msgid "{percent}% of battery remaining ({time})."
msgstr "Noch {percent} % Akkuladung ({time})."

#: bayu-services/battery/batterywarning.cpp
#, python-brace-format
msgid "{percent}% of battery remaining."
msgstr "Noch {percent} % Akkuladung."

#: bayu-services/battery/batterywarning.cpp
msgid "Save your work and connect to power. The computer will shut down when the battery is nearly empty."
msgstr "Speichern Sie Ihre Arbeit und schließen Sie das Netzteil an. Der Computer fährt herunter, wenn der Akku fast leer ist."

#: bayu-services/battery/batterywarning.cpp
msgid "Connect to power. The computer will hibernate when the battery is nearly empty."
msgstr "Schließen Sie das Netzteil an. Der Computer geht in den Ruhezustand, wenn der Akku fast leer ist."

#: bayu-services/battery/batterywarning.cpp
msgid "Save your work and connect to power. The computer will go to sleep when the battery is nearly empty."
msgstr "Speichern Sie Ihre Arbeit und schließen Sie das Netzteil an. Der Computer geht in den Bereitschaftsmodus, wenn der Akku fast leer ist."

#: bayu-services/battery/batterywarning.cpp
msgid "Connect to power soon."
msgstr "Schließen Sie bald das Netzteil an."

#: bayu-services/battery/batterywarning.cpp
msgid "The computer is about to shut down. Connect to power to keep it running."
msgstr "Der Computer fährt gleich herunter. Schließen Sie das Netzteil an, damit er weiterläuft."

#: bayu-services/battery/batterywarning.cpp
msgid "The computer is about to hibernate. Connect to power to keep it running."
msgstr "Der Computer geht gleich in den Ruhezustand. Schließen Sie das Netzteil an, damit er weiterläuft."

#: bayu-services/battery/batterywarning.cpp
msgid "The computer is about to go to sleep. Connect to power to keep it running."
msgstr "Der Computer geht gleich in den Bereitschaftsmodus. Schließen Sie das Netzteil an, damit er weiterläuft."

#: bayu-services/battery/batterywarning.cpp
msgid "Connect to power now."
msgstr "Schließen Sie jetzt das Netzteil an."

#: bayu-services/crash/crashdialog.cpp
#, python-brace-format
msgid "“{name}” quit unexpectedly"
msgstr "„{name}“ wurde unerwartet beendet"

#: bayu-services/crash/crashdialog.cpp
msgid "Hide Details"
msgstr "Details ausblenden"

#: bayu-services/crash/crashdialog.cpp
msgid "Show Details"
msgstr "Details anzeigen"

#: bayu-services/crash/crashdialog.cpp
msgid "Close"
msgstr "Schließen"

#: bayu-services/crash/crashdialog.cpp
msgid "Reopen"
msgstr "Erneut öffnen"

#: bayu-services/crash/crashdialog.cpp
msgid "OK"
msgstr "OK"

#: bayu-services/crash/crashdialog.cpp
#, python-brace-format
msgid "Reason: {reason}"
msgstr "Grund: {reason}"

#: bayu-services/crash/crashdialog.cpp
msgid "It is restarted automatically."
msgstr "Die Anwendung wird automatisch neu gestartet."

#: bayu-services/crash/crashmanager.cpp
msgid "Application Runtime"
msgstr "Anwendungslaufzeit"

#: bayu-services/locale/language.cpp
msgid "Some applications may need to be restarted for the change to take effect."
msgstr "Einige Anwendungen müssen möglicherweise neu gestartet werden, damit die Änderung wirksam wird."

#: bayu-services/permissions/permissionprompt.cpp
msgid "Share your screen?"
msgstr "Bildschirm freigeben?"

#: bayu-services/permissions/permissionprompt.cpp
#, python-brace-format
msgid "Share your screen with “{name}”"
msgstr "Bildschirm mit „{name}“ teilen"

#: bayu-services/permissions/permissionprompt.cpp
msgid "Choose a display or a window. What is shown on it will be visible to the application until it stops sharing."
msgstr "Wählen Sie eine Anzeige oder ein Fenster. Der darauf angezeigte Inhalt ist für die Anwendung sichtbar, bis die Freigabe beendet wird."

#: bayu-services/permissions/permissionprompt.cpp
msgid "Choose a window. Its contents will be visible to the application until it stops sharing."
msgstr "Wählen Sie ein Fenster. Dessen Inhalt ist für die Anwendung sichtbar, bis die Freigabe beendet wird."

#: bayu-services/permissions/permissionprompt.cpp
msgid "Choose a display. Everything shown on it, including other windows, will be visible to the application until it stops sharing."
msgstr "Wählen Sie eine Anzeige. Alles darauf Angezeigte, auch andere Fenster, ist für die Anwendung sichtbar, bis die Freigabe beendet wird."

#: bayu-services/permissions/permissionprompt.cpp
msgid "Share"
msgstr "Teilen"

#: bayu-services/permissions/permissionprompt.cpp
msgid "Windows"
msgstr "Fenster"

#: bayu-services/permissions/permissionprompt.cpp
msgid "Displays"
msgstr "Anzeigen"

#: bayu-services/permissions/permissionprompt.cpp
msgid "Always allow this app"
msgstr "Diese App immer erlauben"

#: bayu-services/permissions/permissionprompt.cpp
msgid "Let “An app” control this computer?"
msgstr "„Eine App“ die Steuerung dieses Computers erlauben?"

#: bayu-services/permissions/permissionprompt.cpp
#, python-brace-format
msgid "Let “{name}” control this computer?"
msgstr "„{name}“ die Steuerung dieses Computers erlauben?"

#: bayu-services/permissions/permissionprompt.cpp
msgid "It will see your screen and use the pointer and keyboard until you stop it with the Stop button in the status bar. Using the pointer or keyboard yourself pauses it, and it cannot answer system dialogs like this one."
msgstr "Die App sieht Ihren Bildschirm und verwendet Zeiger und Tastatur, bis Sie sie mit der Schaltfläche „Stopp“ in der Statusleiste anhalten. Wenn Sie selbst Zeiger oder Tastatur benutzen, wird sie pausiert. Sie kann keine Systemdialoge wie diesen beantworten."

#: bayu-services/permissions/permissionprompt.cpp
msgid "Allow"
msgstr "Erlauben"

#: bayu-services/permissions/permissionprompt.cpp
msgid "Cancel"
msgstr "Abbrechen"

#: session/processmanager.cpp
msgid "Log out cancelled"
msgstr "Abmelden abgebrochen"

#: session/processmanager.cpp
msgid "Restart cancelled"
msgstr "Neustart abgebrochen"

#: session/processmanager.cpp
msgid "Shutdown cancelled"
msgstr "Herunterfahren abgebrochen"

#: session/processmanager.cpp
msgid "An application cancelled it."
msgstr "Eine Anwendung hat den Vorgang abgebrochen."

#: session/processmanager.cpp
msgid "An application did not quit."
msgstr "Eine Anwendung wurde nicht beendet."

#: session/processmanager.cpp
#, python-brace-format
msgid "{name} cancelled it."
msgstr "{name} hat den Vorgang abgebrochen."

#: session/processmanager.cpp
#, python-brace-format
msgid "{name} did not quit."
msgstr "{name} wurde nicht beendet."

#. TRANSLATORS: the sender of a notification from the session itself.
#: session/processmanager.cpp
msgid "System"
msgstr "System"

#: session/bayu-wayland.desktop
msgid "Bayu (Wayland)"
msgstr "Bayu (Wayland)"

#: session/bayu-wayland.desktop
msgid "Bayu desktop session"
msgstr "Bayu-Desktop-Sitzung"
