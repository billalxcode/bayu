#: bayu-services/battery/battery.cpp
msgid "Calculating…"
msgstr "Mengira…"

#: bayu-services/battery/battery.cpp
#, python-brace-format
msgid "{time} until fully charged"
msgstr "{time} lagi sehingga dicas penuh"

#: bayu-services/battery/battery.cpp
#, python-brace-format
msgid "{time} remaining"
msgstr "{time} berbaki"

#: bayu-services/battery/battery.cpp
msgid "Fully charged."
msgstr "Dicas penuh."

#: bayu-services/battery/battery.cpp
#, python-brace-format
msgid "Charging paused at {percent}%"
msgstr "Pengecasan dijeda pada {percent}%"

#: bayu-services/battery/battery.cpp
msgid "Not charging"
msgstr "Tidak mengecas"

#. TRANSLATORS: days in a short battery time such as "1d 2h 5m".
#: bayu-services/battery/battery.cpp
#, python-brace-format
msgid "{n}d"
msgstr "{n}h"

#. TRANSLATORS: hours in a short battery time such as "2h 5m".
#: bayu-services/battery/battery.cpp
#, python-brace-format
msgid "{n}h"
msgstr "{n}j"

#. TRANSLATORS: minutes in a short battery time such as "2h 5m".
#: bayu-services/battery/battery.cpp
#, python-brace-format
msgid "{n}m"
msgstr "{n}m"

#. TRANSLATORS: when the battery was last fully charged, under a minute ago.
#: bayu-services/battery/battery.cpp
msgid "now"
msgstr "sekarang"

#: bayu-services/battery/battery.cpp
#, python-brace-format
msgid "{time} ago"
msgstr "{time} yang lalu"

#: bayu-services/battery/batterywarning.cpp
msgid "Low Battery"
msgstr "Bateri Rendah"

#: bayu-services/battery/batterywarning.cpp
msgid "Battery Critically Low"
msgstr "Bateri Sangat Rendah"

#: bayu-services/battery/batterywarning.cpp
msgid "Battery Empty"
msgstr "Bateri Kosong"

#: bayu-services/battery/batterywarning.cpp
#, python-brace-format
msgid "{percent}% of battery remaining ({time})."
msgstr "{percent}% bateri berbaki ({time})."

#: bayu-services/battery/batterywarning.cpp
#, python-brace-format
msgid "{percent}% of battery remaining."
msgstr "{percent}% bateri berbaki."

#: bayu-services/battery/batterywarning.cpp
msgid "Save your work and connect to power. The computer will shut down when the battery is nearly empty."
msgstr "Simpan kerja anda dan sambung kepada kuasa. Komputer akan dimatikan apabila bateri hampir kosong."

#: bayu-services/battery/batterywarning.cpp
msgid "Connect to power. The computer will hibernate when the battery is nearly empty."
msgstr "Sambung kepada kuasa. Komputer akan hibernasi apabila bateri hampir kosong."

#: bayu-services/battery/batterywarning.cpp
msgid "Save your work and connect to power. The computer will go to sleep when the battery is nearly empty."
msgstr "Simpan kerja anda dan sambung kepada kuasa. Komputer akan tidur apabila bateri hampir kosong."

#: bayu-services/battery/batterywarning.cpp
msgid "Connect to power soon."
msgstr "Sambung kepada kuasa tidak lama lagi."

#: bayu-services/battery/batterywarning.cpp
msgid "The computer is about to shut down. Connect to power to keep it running."
msgstr "Komputer akan dimatikan sebentar lagi. Sambung kepada kuasa untuk memastikannya terus berjalan."

#: bayu-services/battery/batterywarning.cpp
msgid "The computer is about to hibernate. Connect to power to keep it running."
msgstr "Komputer akan hibernasi sebentar lagi. Sambung kepada kuasa untuk memastikannya terus berjalan."

#: bayu-services/battery/batterywarning.cpp
msgid "The computer is about to go to sleep. Connect to power to keep it running."
msgstr "Komputer akan tidur sebentar lagi. Sambung kepada kuasa untuk memastikannya terus berjalan."

#: bayu-services/battery/batterywarning.cpp
msgid "Connect to power now."
msgstr "Sambung kepada kuasa sekarang."

#: bayu-services/crash/crashdialog.cpp
#, python-brace-format
msgid "“{name}” quit unexpectedly"
msgstr "“{name}” keluar secara tidak dijangka"

#: bayu-services/crash/crashdialog.cpp
msgid "Hide Details"
msgstr "Sembunyikan Butiran"

#: bayu-services/crash/crashdialog.cpp
msgid "Show Details"
msgstr "Tunjukkan Butiran"

#: bayu-services/crash/crashdialog.cpp
msgid "Close"
msgstr "Tutup"

#: bayu-services/crash/crashdialog.cpp
msgid "Reopen"
msgstr "Buka Semula"

#: bayu-services/crash/crashdialog.cpp
msgid "OK"
msgstr "OK"

#: bayu-services/crash/crashdialog.cpp
#, python-brace-format
msgid "Reason: {reason}"
msgstr "Sebab: {reason}"

#: bayu-services/crash/crashdialog.cpp
msgid "It is restarted automatically."
msgstr "Ia dimulakan semula secara automatik."

#: bayu-services/crash/crashmanager.cpp
msgid "Application Runtime"
msgstr "Masa Jalan Aplikasi"

#: bayu-services/locale/language.cpp
msgid "Some applications may need to be restarted for the change to take effect."
msgstr "Sesetengah aplikasi mungkin perlu dimulakan semula supaya perubahan berkuat kuasa."

#: bayu-services/permissions/permissionprompt.cpp
#, python-brace-format
msgid "Share your screen with “{name}”"
msgstr "Kongsi skrin anda dengan “{name}”"

#: bayu-services/permissions/permissionprompt.cpp
msgid "Choose a display or a window. What is shown on it will be visible to the application until it stops sharing."
msgstr "Pilih paparan atau tetingkap. Apa yang ditunjukkan padanya akan kelihatan kepada aplikasi sehingga perkongsian dihentikan."

#: bayu-services/permissions/permissionprompt.cpp
msgid "Choose a window. Its contents will be visible to the application until it stops sharing."
msgstr "Pilih tetingkap. Kandungannya akan kelihatan kepada aplikasi sehingga perkongsian dihentikan."

#: bayu-services/permissions/permissionprompt.cpp
msgid "Choose a display. Everything shown on it, including other windows, will be visible to the application until it stops sharing."
msgstr "Pilih paparan. Semua yang ditunjukkan padanya, termasuk tetingkap lain, akan kelihatan kepada aplikasi sehingga perkongsian dihentikan."

#: bayu-services/permissions/permissionprompt.cpp
msgid "Share"
msgstr "Kongsi"

#: bayu-services/permissions/permissionprompt.cpp
msgid "Windows"
msgstr "Tetingkap"

#: bayu-services/permissions/permissionprompt.cpp
msgid "Displays"
msgstr "Paparan"

#: bayu-services/permissions/permissionprompt.cpp
msgid "Always allow this app"
msgstr "Sentiasa benarkan aplikasi ini"

#: bayu-services/permissions/permissionprompt.cpp
msgid "Let “An app” control this computer?"
msgstr "Benarkan “Sebuah aplikasi” mengawal komputer ini?"

#: bayu-services/permissions/permissionprompt.cpp
#, python-brace-format
msgid "Let “{name}” control this computer?"
msgstr "Benarkan “{name}” mengawal komputer ini?"

#: bayu-services/permissions/permissionprompt.cpp
msgid "It will see your screen and use the pointer and keyboard until you stop it with the Stop button in the status bar. Using the pointer or keyboard yourself pauses it, and it cannot answer system dialogs like this one."
msgstr "Ia akan melihat skrin anda dan menggunakan penuding serta papan kekunci sehingga anda menghentikannya dengan butang Henti dalam bar status. Menggunakan penuding atau papan kekunci sendiri akan menjedanya, dan ia tidak boleh menjawab dialog sistem seperti ini."

#: bayu-services/permissions/permissionprompt.cpp
msgid "Allow"
msgstr "Benarkan"

#: bayu-services/permissions/permissionprompt.cpp
msgid "Cancel"
msgstr "Batal"

#: session/processmanager.cpp
msgid "Log out cancelled"
msgstr "Log keluar dibatalkan"

#: session/processmanager.cpp
msgid "Restart cancelled"
msgstr "Mula semula dibatalkan"

#: session/processmanager.cpp
msgid "Shutdown cancelled"
msgstr "Penutupan dibatalkan"

#: session/processmanager.cpp
msgid "An application cancelled it."
msgstr "Sebuah aplikasi telah membatalkannya."

#: session/processmanager.cpp
msgid "An application did not quit."
msgstr "Sebuah aplikasi tidak keluar."

#: session/processmanager.cpp
#, python-brace-format
msgid "{name} cancelled it."
msgstr "{name} telah membatalkannya."

#: session/processmanager.cpp
#, python-brace-format
msgid "{name} did not quit."
msgstr "{name} tidak keluar."

#. TRANSLATORS: the sender of a notification from the session itself.
#: session/processmanager.cpp
msgid "System"
msgstr "Sistem"

#: session/bayu-wayland.desktop
msgid "Bayu (Wayland)"
msgstr "Bayu (Wayland)"

#: session/bayu-wayland.desktop
msgid "Bayu desktop session"
msgstr "Sesi desktop Bayu"
