#: bayu-services/battery/battery.cpp
msgid "Calculating…"
msgstr "Ngitung…"

#: bayu-services/battery/battery.cpp
#, python-brace-format
msgid "{time} until fully charged"
msgstr "{time} nganti kebak"

#: bayu-services/battery/battery.cpp
#, python-brace-format
msgid "{time} remaining"
msgstr "Isih {time}"

#: bayu-services/battery/battery.cpp
msgid "Fully charged."
msgstr "Kebak."

#: bayu-services/battery/battery.cpp
#, python-brace-format
msgid "Charging paused at {percent}%"
msgstr "Pangisian daya dijeda ing {percent}%"

#: bayu-services/battery/battery.cpp
msgid "Not charging"
msgstr "Ora ngisi daya"

#. TRANSLATORS: days in a short battery time such as "1d 2h 5m".
#: bayu-services/battery/battery.cpp
#, python-brace-format
msgid "{n}d"
msgstr "{n}d"

#. TRANSLATORS: hours in a short battery time such as "2h 5m".
#: bayu-services/battery/battery.cpp
#, python-brace-format
msgid "{n}h"
msgstr "{n}j"

#. TRANSLATORS: minutes in a short battery time such as "2h 5m".
#: bayu-services/battery/battery.cpp
#, python-brace-format
msgid "{n}m"
msgstr "{n}m"

#. TRANSLATORS: when the battery was last fully charged, under a minute ago.
#: bayu-services/battery/battery.cpp
msgid "now"
msgstr "saiki"

#: bayu-services/battery/battery.cpp
#, python-brace-format
msgid "{time} ago"
msgstr "{time} kepungkur"

#: bayu-services/battery/batterywarning.cpp
msgid "Low Battery"
msgstr "Baterei Meh Entek"

#: bayu-services/battery/batterywarning.cpp
msgid "Battery Critically Low"
msgstr "Baterei Kritis"

#: bayu-services/battery/batterywarning.cpp
msgid "Battery Empty"
msgstr "Baterei Entek"

#: bayu-services/battery/batterywarning.cpp
#, python-brace-format
msgid "{percent}% of battery remaining ({time})."
msgstr "Baterei isih {percent}% ({time})."

#: bayu-services/battery/batterywarning.cpp
#, python-brace-format
msgid "{percent}% of battery remaining."
msgstr "Baterei isih {percent}%."

#: bayu-services/battery/batterywarning.cpp
msgid "Save your work and connect to power. The computer will shut down when the battery is nearly empty."
msgstr "Simpenen pagaweyan sampeyan lan sambungna menyang listrik. Komputer bakal mati yen baterei meh entek."

#: bayu-services/battery/batterywarning.cpp
msgid "Connect to power. The computer will hibernate when the battery is nearly empty."
msgstr "Sambungna menyang listrik. Komputer bakal hibernasi yen baterei meh entek."

#: bayu-services/battery/batterywarning.cpp
msgid "Save your work and connect to power. The computer will go to sleep when the battery is nearly empty."
msgstr "Simpenen pagaweyan sampeyan lan sambungna menyang listrik. Komputer bakal turu yen baterei meh entek."

#: bayu-services/battery/batterywarning.cpp
msgid "Connect to power soon."
msgstr "Enggal sambungna menyang listrik."

#: bayu-services/battery/batterywarning.cpp
msgid "The computer is about to shut down. Connect to power to keep it running."
msgstr "Komputer bakal mati. Sambungna menyang listrik supaya tetep urip."

#: bayu-services/battery/batterywarning.cpp
msgid "The computer is about to hibernate. Connect to power to keep it running."
msgstr "Komputer bakal hibernasi. Sambungna menyang listrik supaya tetep urip."

#: bayu-services/battery/batterywarning.cpp
msgid "The computer is about to go to sleep. Connect to power to keep it running."
msgstr "Komputer bakal turu. Sambungna menyang listrik supaya tetep urip."

#: bayu-services/battery/batterywarning.cpp
msgid "Connect to power now."
msgstr "Sambungna menyang listrik saiki."

#: bayu-services/crash/crashdialog.cpp
#, python-brace-format
msgid "“{name}” quit unexpectedly"
msgstr "“{name}” metu dumadakan"

#: bayu-services/crash/crashdialog.cpp
msgid "Hide Details"
msgstr "Delikna Rincian"

#: bayu-services/crash/crashdialog.cpp
msgid "Show Details"
msgstr "Tuduhna Rincian"

#: bayu-services/crash/crashdialog.cpp
msgid "Close"
msgstr "Tutup"

#: bayu-services/crash/crashdialog.cpp
msgid "Reopen"
msgstr "Bukak Maneh"

#: bayu-services/crash/crashdialog.cpp
msgid "OK"
msgstr "OK"

#: bayu-services/crash/crashdialog.cpp
#, python-brace-format
msgid "Reason: {reason}"
msgstr "Sebab: {reason}"

#: bayu-services/crash/crashdialog.cpp
msgid "It is restarted automatically."
msgstr "Diwiwiti maneh kanthi otomatis."

#: bayu-services/crash/crashmanager.cpp
msgid "Application Runtime"
msgstr "Runtime Aplikasi"

#: bayu-services/locale/language.cpp
msgid "Some applications may need to be restarted for the change to take effect."
msgstr "Sawetara aplikasi mbokmenawa kudu diwiwiti maneh supaya owah-owahan bisa ditrapake."

#: bayu-services/permissions/permissionprompt.cpp
msgid "Share your screen?"
msgstr "Bagekake layar sampeyan?"

#: bayu-services/permissions/permissionprompt.cpp
#, python-brace-format
msgid "Share your screen with “{name}”"
msgstr "Bagekake layar sampeyan karo “{name}”"

#: bayu-services/permissions/permissionprompt.cpp
msgid "Choose a display or a window. What is shown on it will be visible to the application until it stops sharing."
msgstr "Pilih layar utawa jendhela. Sing katon ing kono bakal katon dening aplikasi nganti mandheg dibagekake."

#: bayu-services/permissions/permissionprompt.cpp
msgid "Choose a window. Its contents will be visible to the application until it stops sharing."
msgstr "Pilih jendhela. Isine bakal katon dening aplikasi nganti mandheg dibagekake."

#: bayu-services/permissions/permissionprompt.cpp
msgid "Choose a display. Everything shown on it, including other windows, will be visible to the application until it stops sharing."
msgstr "Pilih layar. Kabeh sing katon ing kono, kalebu jendhela liyane, bakal katon dening aplikasi nganti mandheg dibagekake."

#: bayu-services/permissions/permissionprompt.cpp
msgid "Share"
msgstr "Bagekake"

#: bayu-services/permissions/permissionprompt.cpp
msgid "Windows"
msgstr "Jendhela"

#: bayu-services/permissions/permissionprompt.cpp
msgid "Displays"
msgstr "Layar"

#: bayu-services/permissions/permissionprompt.cpp
msgid "Always allow this app"
msgstr "Tansah idini aplikasi iki"

#: bayu-services/permissions/permissionprompt.cpp
msgid "Let “An app” control this computer?"
msgstr "Idini “An app” ngontrol komputer iki?"

#: bayu-services/permissions/permissionprompt.cpp
#, python-brace-format
msgid "Let “{name}” control this computer?"
msgstr "Idini “{name}” ngontrol komputer iki?"

#: bayu-services/permissions/permissionprompt.cpp
msgid "It will see your screen and use the pointer and keyboard until you stop it with the Stop button in the status bar. Using the pointer or keyboard yourself pauses it, and it cannot answer system dialogs like this one."
msgstr "Bakal ndeleng layar sampeyan lan nggunakake penuding lan papan tombol nganti sampeyan mandhegake nganggo tombol Mandheg ing bilah status. Yen sampeyan nggunakake penuding utawa papan tombol dhewe, bakal dijeda, lan ora bisa mangsuli dialog sistem kaya iki."

#: bayu-services/permissions/permissionprompt.cpp
msgid "Allow"
msgstr "Idini"

#: bayu-services/permissions/permissionprompt.cpp
msgid "Cancel"
msgstr "Batal"

#: session/processmanager.cpp
msgid "Log out cancelled"
msgstr "Metu dibatalake"

#: session/processmanager.cpp
msgid "Restart cancelled"
msgstr "Miwiti maneh dibatalake"

#: session/processmanager.cpp
msgid "Shutdown cancelled"
msgstr "Pateni dibatalake"

#: session/processmanager.cpp
msgid "An application cancelled it."
msgstr "Sawijining aplikasi mbatalake."

#: session/processmanager.cpp
msgid "An application did not quit."
msgstr "Sawijining aplikasi ora metu."

#: session/processmanager.cpp
#, python-brace-format
msgid "{name} cancelled it."
msgstr "{name} mbatalake."

#: session/processmanager.cpp
#, python-brace-format
msgid "{name} did not quit."
msgstr "{name} ora metu."

#. TRANSLATORS: the sender of a notification from the session itself.
#: session/processmanager.cpp
msgid "System"
msgstr "Sistem"

#: session/bayu-wayland.desktop
msgid "Bayu (Wayland)"
msgstr "Bayu (Wayland)"

#: session/bayu-wayland.desktop
msgid "Bayu desktop session"
msgstr "Sesi desktop Bayu"
