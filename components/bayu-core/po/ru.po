#: bayu-services/battery/battery.cpp
msgid "Calculating…"
msgstr "Вычисление…"

#: bayu-services/battery/battery.cpp
#, python-brace-format
msgid "{time} until fully charged"
msgstr "До полной зарядки: {time}"

#: bayu-services/battery/battery.cpp
#, python-brace-format
msgid "{time} remaining"
msgstr "Осталось: {time}"

#: bayu-services/battery/battery.cpp
msgid "Fully charged."
msgstr "Полностью заряжена."

#: bayu-services/battery/battery.cpp
#, python-brace-format
msgid "Charging paused at {percent}%"
msgstr "Зарядка приостановлена на {percent}%"

#: bayu-services/battery/battery.cpp
msgid "Not charging"
msgstr "Не заряжается"

#. TRANSLATORS: days in a short battery time such as "1d 2h 5m".
#: bayu-services/battery/battery.cpp
#, python-brace-format
msgid "{n}d"
msgstr "{n} д"

#. TRANSLATORS: hours in a short battery time such as "2h 5m".
#: bayu-services/battery/battery.cpp
#, python-brace-format
msgid "{n}h"
msgstr "{n} ч"

#. TRANSLATORS: minutes in a short battery time such as "2h 5m".
#: bayu-services/battery/battery.cpp
#, python-brace-format
msgid "{n}m"
msgstr "{n} м"

#. TRANSLATORS: when the battery was last fully charged, under a minute ago.
#: bayu-services/battery/battery.cpp
msgid "now"
msgstr "сейчас"

#: bayu-services/battery/battery.cpp
#, python-brace-format
msgid "{time} ago"
msgstr "{time} назад"

#: bayu-services/battery/batterywarning.cpp
msgid "Low Battery"
msgstr "Низкий заряд батареи"

#: bayu-services/battery/batterywarning.cpp
msgid "Battery Critically Low"
msgstr "Критически низкий заряд батареи"

#: bayu-services/battery/batterywarning.cpp
msgid "Battery Empty"
msgstr "Батарея разряжена"

#: bayu-services/battery/batterywarning.cpp
#, python-brace-format
msgid "{percent}% of battery remaining ({time})."
msgstr "Осталось {percent}% заряда батареи ({time})."

#: bayu-services/battery/batterywarning.cpp
#, python-brace-format
msgid "{percent}% of battery remaining."
msgstr "Осталось {percent}% заряда батареи."

#: bayu-services/battery/batterywarning.cpp
msgid "Save your work and connect to power. The computer will shut down when the battery is nearly empty."
msgstr "Сохраните работу и подключите питание. Компьютер выключится, когда батарея почти разрядится."

#: bayu-services/battery/batterywarning.cpp
msgid "Connect to power. The computer will hibernate when the battery is nearly empty."
msgstr "Подключите питание. Компьютер перейдёт в режим гибернации, когда батарея почти разрядится."

#: bayu-services/battery/batterywarning.cpp
msgid "Save your work and connect to power. The computer will go to sleep when the battery is nearly empty."
msgstr "Сохраните работу и подключите питание. Компьютер перейдёт в спящий режим, когда батарея почти разрядится."

#: bayu-services/battery/batterywarning.cpp
msgid "Connect to power soon."
msgstr "Скоро подключите питание."

#: bayu-services/battery/batterywarning.cpp
msgid "The computer is about to shut down. Connect to power to keep it running."
msgstr "Компьютер вот-вот выключится. Подключите питание, чтобы он продолжил работу."

#: bayu-services/battery/batterywarning.cpp
msgid "The computer is about to hibernate. Connect to power to keep it running."
msgstr "Компьютер вот-вот перейдёт в режим гибернации. Подключите питание, чтобы он продолжил работу."

#: bayu-services/battery/batterywarning.cpp
msgid "The computer is about to go to sleep. Connect to power to keep it running."
msgstr "Компьютер вот-вот перейдёт в спящий режим. Подключите питание, чтобы он продолжил работу."

#: bayu-services/battery/batterywarning.cpp
msgid "Connect to power now."
msgstr "Подключите питание сейчас."

#: bayu-services/crash/crashdialog.cpp
#, python-brace-format
msgid "“{name}” quit unexpectedly"
msgstr "Приложение «{name}» неожиданно завершилось"

#: bayu-services/crash/crashdialog.cpp
msgid "Hide Details"
msgstr "Скрыть подробности"

#: bayu-services/crash/crashdialog.cpp
msgid "Show Details"
msgstr "Показать подробности"

#: bayu-services/crash/crashdialog.cpp
msgid "Close"
msgstr "Закрыть"

#: bayu-services/crash/crashdialog.cpp
msgid "Reopen"
msgstr "Открыть снова"

#: bayu-services/crash/crashdialog.cpp
msgid "OK"
msgstr "OK"

#: bayu-services/crash/crashdialog.cpp
#, python-brace-format
msgid "Reason: {reason}"
msgstr "Причина: {reason}"

#: bayu-services/crash/crashdialog.cpp
msgid "It is restarted automatically."
msgstr "Оно будет перезапущено автоматически."

#: bayu-services/crash/crashmanager.cpp
msgid "Application Runtime"
msgstr "Среда выполнения приложений"

#: bayu-services/locale/language.cpp
msgid "Some applications may need to be restarted for the change to take effect."
msgstr "Некоторым приложениям может потребоваться перезапуск, чтобы изменение вступило в силу."

#: bayu-services/permissions/permissionprompt.cpp
msgid "Share your screen?"
msgstr "Поделиться экраном?"

#: bayu-services/permissions/permissionprompt.cpp
#, python-brace-format
msgid "Share your screen with “{name}”"
msgstr "Показать экран приложению «{name}»"

#: bayu-services/permissions/permissionprompt.cpp
msgid "Choose a display or a window. What is shown on it will be visible to the application until it stops sharing."
msgstr "Выберите дисплей или окно. Всё, что на нём показано, будет видно приложению, пока оно не прекратит демонстрацию."

#: bayu-services/permissions/permissionprompt.cpp
msgid "Choose a window. Its contents will be visible to the application until it stops sharing."
msgstr "Выберите окно. Его содержимое будет видно приложению, пока оно не прекратит демонстрацию."

#: bayu-services/permissions/permissionprompt.cpp
msgid "Choose a display. Everything shown on it, including other windows, will be visible to the application until it stops sharing."
msgstr "Выберите дисплей. Всё, что на нём показано, включая другие окна, будет видно приложению, пока оно не прекратит демонстрацию."

#: bayu-services/permissions/permissionprompt.cpp
msgid "Share"
msgstr "Поделиться"

#: bayu-services/permissions/permissionprompt.cpp
msgid "Windows"
msgstr "Окна"

#: bayu-services/permissions/permissionprompt.cpp
msgid "Displays"
msgstr "Дисплеи"

#: bayu-services/permissions/permissionprompt.cpp
msgid "Always allow this app"
msgstr "Всегда разрешать этому приложению"

#: bayu-services/permissions/permissionprompt.cpp
msgid "Let “An app” control this computer?"
msgstr "Разрешить «Приложению» управлять этим компьютером?"

#: bayu-services/permissions/permissionprompt.cpp
#, python-brace-format
msgid "Let “{name}” control this computer?"
msgstr "Разрешить «{name}» управлять этим компьютером?"

#: bayu-services/permissions/permissionprompt.cpp
msgid "It will see your screen and use the pointer and keyboard until you stop it with the Stop button in the status bar. Using the pointer or keyboard yourself pauses it, and it cannot answer system dialogs like this one."
msgstr "Оно будет видеть ваш экран и пользоваться указателем и клавиатурой, пока вы не остановите его кнопкой «Стоп» в строке состояния. Если вы сами воспользуетесь указателем или клавиатурой, оно приостановится; оно не может отвечать на системные диалоги, подобные этому."

#: bayu-services/permissions/permissionprompt.cpp
msgid "Allow"
msgstr "Разрешить"

#: bayu-services/permissions/permissionprompt.cpp
msgid "Cancel"
msgstr "Отмена"

#: session/processmanager.cpp
msgid "Log out cancelled"
msgstr "Выход отменён"

#: session/processmanager.cpp
msgid "Restart cancelled"
msgstr "Перезагрузка отменена"

#: session/processmanager.cpp
msgid "Shutdown cancelled"
msgstr "Выключение отменено"

#: session/processmanager.cpp
msgid "An application cancelled it."
msgstr "Приложение отменило его."

#: session/processmanager.cpp
msgid "An application did not quit."
msgstr "Приложение не завершилось."

#: session/processmanager.cpp
#, python-brace-format
msgid "{name} cancelled it."
msgstr "{name} отменило его."

#: session/processmanager.cpp
#, python-brace-format
msgid "{name} did not quit."
msgstr "{name} не завершилось."

#. TRANSLATORS: the sender of a notification from the session itself.
#: session/processmanager.cpp
msgid "System"
msgstr "Система"

#: session/bayu-wayland.desktop
msgid "Bayu (Wayland)"
msgstr "Bayu (Wayland)"

#: session/bayu-wayland.desktop
msgid "Bayu desktop session"
msgstr "Сеанс рабочего стола Bayu"
