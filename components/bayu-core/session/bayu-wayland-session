#!/bin/sh
# Session management stays in core/session; it supervises bayu-compositor.
export XDG_CURRENT_DESKTOP=Bayu
export XDG_SESSION_DESKTOP=Bayu
export DESKTOP_SESSION=Bayu
export XDG_SESSION_TYPE=wayland
export WAYLAND_DISPLAY=bayu-0
unset DISPLAY XAUTHORITY WAYLAND_SOCKET
exec /usr/bin/bayu-session "$@"
