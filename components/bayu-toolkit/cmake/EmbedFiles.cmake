# Writes a C++ source that holds each file's bytes, looked up by file name:
#   cmake -DOUTPUT=out.cpp -DFILES="a.svg|b.svg" -P EmbedFiles.cmake
string(REPLACE "|" ";" FILES "${FILES}")
set(entries "")
set(arrays "")
set(index 0)
foreach(file ${FILES})
    file(READ ${file} hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    get_filename_component(name ${file} NAME)
    string(APPEND arrays "static const unsigned char kFile${index}[] = {${bytes}};\n")
    string(APPEND entries "    {\"${name}\", kFile${index}, sizeof(kFile${index})},\n")
    math(EXPR index "${index} + 1")
endforeach()
file(WRITE ${OUTPUT} "// Generated by EmbedFiles.cmake.
#include \"ui/embedded_files.h\"

#include <cstring>

namespace bayu::ui {

${arrays}
static const EmbeddedFile kFiles[] = {
${entries}};

const EmbeddedFile* findEmbeddedFile(const char* name)
{
    for (const EmbeddedFile& file : kFiles) {
        if (std::strcmp(file.name, name) == 0)
            return &file;
    }
    return nullptr;
}

} // namespace bayu::ui
")
