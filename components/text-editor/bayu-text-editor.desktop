[Desktop Entry]
Version=1.0
Name=Text Editor
Comment=Edit plain text files
Exec=bayu-text-editor %U
Icon=accessories-text-editor
Terminal=false
Type=Application
Categories=Utility;TextEditor;
Keywords=Text;Editor;Plain;Notes;Code;
MimeType=text/plain;text/markdown;text/x-csrc;text/x-chdr;text/x-c++src;text/x-c++hdr;text/x-python;text/x-python3;application/x-shellscript;text/x-sh;application/json;application/xml;text/xml;text/html;text/css;application/javascript;text/javascript;application/x-yaml;application/toml;text/x-cmake;text/x-makefile;text/x-patch;text/x-diff;text/x-log;text/x-java;text/x-go;text/rust;application/sql;text/x-ini;application/x-desktop;text/x-qml;
StartupNotify=true
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=bayu-text-editor --new-window
