msgid "The login helper did not start"
msgstr "로그인 도우미가 시작되지 않았습니다"

#: helper/main.cpp
msgid "Expected a login request"
msgstr "로그인 요청이 필요합니다"

#: helper/main.cpp
msgid "Incomplete login request"
msgstr "로그인 요청이 완전하지 않습니다"

#: helper/main.cpp
